{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "jsx": "react-jsx",
    "moduleResolution": "Bundler",
    "sourceMap": true,
    "rootDir": "src",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@common/*": ["./src/common/*"],
      "@services/*": ["./src/services/*"],
      "@webview/*": ["./src/webview/*"]
    }
  },

  "include": ["src/webview", "src/common", "src/services/taskConstraintService.ts"]
}
