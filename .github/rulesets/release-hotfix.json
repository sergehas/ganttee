{
  "name": "release and hotfix branches",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["refs/heads/release/**/*", "refs/heads/hotfix/**/*"],
      "exclude": []
    }
  },
  "bypass_actors": [],
  "rules": [{ "type": "non_fast_forward" }]
}
